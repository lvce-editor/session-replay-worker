{
  "name": "@lvce-editor/session-replay-worker",
  "version": "0.0.0-dev",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/session-replay-worker.git"
  },
  "exports": {
    "./api": "./src/parts/Api/Api.ts",
    "./capture": "./src/parts/Capture/Capture.ts",
    "./client": "./src/parts/Client/Client.ts",
    "./player": "./src/parts/Player/Player.ts",
    "./settings": "./settings.json",
    "./worker": "./src/sessionReplayWorkerMain.ts"
  },
  "main": "src/sessionReplayWorkerMain.ts",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "files": [
    "settings.json",
    "src"
  ],
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/constants": "^5.30.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.13.3",
    "css-tree": "^3.2.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
