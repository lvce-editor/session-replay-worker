{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.ts"]
    },
    "packages/build": {
      "entry": ["test/**/*.test.ts", "static/replay/main.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["server.ts", "fixture.ts", "browser/main.ts", "browser/fixture.ts"],
      "project": ["*.ts", "browser/**/*.ts"]
    },
    "packages/session-replay-worker": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
