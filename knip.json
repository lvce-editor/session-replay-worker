{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/e2e": {
      "entry": ["server.ts"],
      "project": ["*.ts"]
    },
    "packages/session-replay-worker": {
      "entry": ["test/**/*.test.js"],
      "project": ["src/**/*.js", "test/**/*.js"]
    }
  }
}
